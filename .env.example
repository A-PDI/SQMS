# ---------------------------------------------------------------------------------------------
# SQMS environment configuration (example). Copy to .env for local development.
# Never commit real credentials. Production values must come from a secrets manager.
# ---------------------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public origin(s) of the web app (comma separated). Required in production.
APP_ORIGINS=http://localhost:3000,http://localhost:8080
APP_BASE_URL=http://localhost:3000
TRUST_PROXY=false

# Application database account (DML only). Migrations use MIGRATION_DATABASE_URL (DDL-capable account).
DATABASE_URL=mysql://sqms_app:change-me-app@127.0.0.1:3306/sqms
MIGRATION_DATABASE_URL=mysql://sqms_migrator:change-me-migrator@127.0.0.1:3306/sqms
SHADOW_DATABASE_URL=mysql://sqms_migrator:change-me-migrator@127.0.0.1:3306/sqms_shadow
DATABASE_CONNECTION_LIMIT=10
REDIS_URL=redis://127.0.0.1:6379

# Session & CSRF
CSRF_SECRET=replace-with-at-least-32-random-characters
# Set to false ONLY for plain-http local development.
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_HOURS=72
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=600

# Phase 1: external supplier logins and portal APIs are disabled.
SUPPLIER_PORTAL_ENABLED=false
EXTERNAL_MFA_PROVIDER=none

# S3-compatible object storage (MinIO locally). Buckets are private; files are served only through the API.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=sqms-files
S3_ACCESS_KEY_ID=change-me-minio-user
S3_SECRET_ACCESS_KEY=change-me-minio-password
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true

# Malware scanning (files remain quarantined until scanned clean)
SCANNER_MODE=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Email (Mailpit locally: UI at http://localhost:8025)
MAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=SQMS <no-reply@sqms.local>

LOG_LEVEL=log
LOG_JSON=false
SWAGGER_ENABLED=true

# Reference seed: initial administrator (only created when both are set; never use these values in production)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Demo seed (development only): password applied to all fictional demo users
DEMO_USER_PASSWORD=
