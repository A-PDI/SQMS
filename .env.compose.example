# Environment for `docker compose --env-file .env.compose ...`. Copy to .env.compose and replace EVERY change-me
# value with a long random secret (e.g. `openssl rand -base64 36`). Never commit .env.compose.

# Public URL users open in the browser (also the allowed origin for CSRF checks).
SQMS_PUBLIC_URL=http://localhost:8080
# Gateway site address: ":8080" for local HTTP; a DNS name (e.g. sqms.example.com) enables automatic HTTPS.
SQMS_SITE_ADDRESS=:8080
SQMS_HTTP_PORT=8080

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
SQMS_DB_NAME=sqms
SQMS_MIGRATOR_USER=sqms_migrator
SQMS_MIGRATOR_PASSWORD=change-me-migrator
SQMS_APP_USER=sqms_app
SQMS_APP_PASSWORD=change-me-app
SQMS_REPORTER_PASSWORD=change-me-reporter

# Redis
REDIS_PASSWORD=change-me-redis

# MinIO (root credentials stay inside MinIO; the application uses the bucket-scoped account below)
MINIO_ROOT_USER=sqms-minio-admin
MINIO_ROOT_PASSWORD=change-me-minio-root
S3_BUCKET=sqms-files
S3_ACCESS_KEY_ID=sqms-app
S3_SECRET_ACCESS_KEY=change-me-minio-app

# Sessions / CSRF (at least 32 random characters)
CSRF_SECRET=change-me-to-at-least-32-random-characters

# Phase 1: supplier logins stay disabled.
SUPPLIER_PORTAL_ENABLED=false

# Mail: defaults deliver to the local Mailpit sink (UI on http://127.0.0.1:8025). Use your relay in production.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=SQMS <no-reply@sqms.local>

# First administrator, created by the migrate job on an empty database (choose your own strong password).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_ADMIN_NAME=SQMS Administrator

# Only for `--profile demo` (fictional data, evaluation only).
DEMO_USER_PASSWORD=

# Optional root CA file for image builds behind a TLS-inspecting proxy.
# SQMS_BUILD_CA_FILE=/path/to/corporate-ca.pem
